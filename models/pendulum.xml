<mujoco model="simple_pendulum">

    <option gravity="0 0 -9.81"/>

    <worldbody>

        <!-- Ground -->
        <geom type="plane" size="5 5 0.1"/>

        <!-- Pivot point -->
        <body pos="0 0 1.3">

            <!-- Rotational joint -->
            <joint name="hinge" type="hinge" axis="0 1 0"/>

            <!-- Pendulum rod. Most robotic arms use capsules because they produce stable collision behavior. -->
            <geom type="capsule"
                  fromto="0 0 0 0 0 -1"
                  size="0.04"/>

        </body>

    </worldbody>

</mujoco>